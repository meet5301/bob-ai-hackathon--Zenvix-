# ── Database ──────────────────────────────────────────────────────────────────
# Full Neon Postgres connection string (postgres://user:pass@host/db?sslmode=require)
NEON_DATABASE_URL=postgres://user:password@host.neon.tech/neondb?sslmode=require

# ── IBM watsonx.ai (Bob) ──────────────────────────────────────────────────────
# API key from your IBM Cloud IAM credentials page
WATSONX_API_KEY=your_watsonx_api_key_here

# Project ID from your watsonx.ai project settings
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# Regional endpoint for watsonx.ai inference (e.g. https://us-south.ml.cloud.ibm.com)
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ── Dashboard → FastAPI ────────────────────────────────────────────────────────
# Base URL of the running FastAPI service, used by the Streamlit dashboard
API_BASE_URL=http://localhost:8000

# ── Data Generation / ETL ─────────────────────────────────────────────────────
# Directory where generate_fake_data.py and fetch_weather.py write CSV output
DATA_OUTPUT_DIR=data/raw

# ── ML ────────────────────────────────────────────────────────────────────────
# Path where the trained XGBoost model artifact is saved / loaded from
MODEL_PATH=models/xgb_failure_model.joblib
